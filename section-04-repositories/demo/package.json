    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts"
  },
  "dependencies": {
    "dotenv": "workspace:*",
    "pg": "workspace:*",
    "reflect-metadata": "workspace:*",
    "typeorm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "workspace:*",
    "ts-node": "workspace:*",
    "typescript": "workspace:*"
  }
}
