# MongoDB Connection (Docker)
# Start MongoDB: docker-compose -f docker-compose.mongodb.yml up -d
MONGODB_URI=mongodb://localhost:27017/mongoose_essentials

# With authentication
# MONGODB_URI=mongodb://admin:password123@localhost:27017/mongoose_essentials?authSource=admin

# Or use MongoDB Atlas
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mongoose_essentials
