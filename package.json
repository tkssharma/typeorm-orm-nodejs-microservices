{
  "name": "typeorm-course",
  "version": "1.0.0",
  "private": true,
  "description": "TypeORM Course with TypeScript and Node.js - Monorepo",
  "scripts": {
    "dev:02": "pnpm --filter section-02-demo dev",
    "dev:02-express": "pnpm --filter section-02-express-demo dev",
    "dev:03": "pnpm --filter section-03-demo dev",
    "dev:04": "pnpm --filter section-04-demo dev",
    "dev:05": "pnpm --filter section-05-demo dev",
    "dev:06": "pnpm --filter section-06-typeorm-cli-demo dev",
    "dev:07": "pnpm --filter section-07-demo dev",
    "dev:08": "pnpm --filter section-08-demo dev",
    "dev:10": "pnpm --filter section-10-demo dev",
    "dev:10-nodejs": "pnpm --filter section-10-nodejs-demo dev",
    "dev:11": "pnpm --filter section-11-demo dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rm -rf node_modules dist",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
